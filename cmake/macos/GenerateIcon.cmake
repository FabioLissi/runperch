if(NOT DEFINED SOURCE_PNG OR NOT DEFINED OUTPUT_ICNS)
  message(FATAL_ERROR "SOURCE_PNG and OUTPUT_ICNS are required")
endif()
set(iconset "${OUTPUT_ICNS}.iconset")
file(MAKE_DIRECTORY "${iconset}")
foreach(size IN ITEMS 16 32 128 256 512)
  foreach(scale IN ITEMS 1 2)
    math(EXPR pixels "${size} * ${scale}")
    if(scale EQUAL 1)
      set(name "icon_${size}x${size}.png")
    else()
      set(name "icon_${size}x${size}@2x.png")
    endif()
    execute_process(COMMAND /usr/bin/sips -z ${pixels} ${pixels} "${SOURCE_PNG}" --out "${iconset}/${name}"
      RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "sips failed: ${error}")
    endif()
  endforeach()
endforeach()
execute_process(COMMAND /usr/bin/iconutil -c icns "${iconset}" -o "${OUTPUT_ICNS}"
  RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "iconutil failed: ${error}")
endif()
