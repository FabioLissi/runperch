execute_process(COMMAND /usr/bin/plutil -extract CFBundleIconFile raw -o - "${APP_PATH}/Contents/Info.plist"
  RESULT_VARIABLE status OUTPUT_VARIABLE icon OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT status EQUAL 0 OR icon STREQUAL "")
  message(FATAL_ERROR "Bundle has no CFBundleIconFile")
endif()
if(NOT icon MATCHES "\\.icns$")
  string(APPEND icon ".icns")
endif()
set(path "${APP_PATH}/Contents/Resources/${icon}")
if(NOT EXISTS "${path}")
  message(FATAL_ERROR "Bundle icon resource is missing: ${icon}")
endif()
file(READ "${path}" header OFFSET 0 LIMIT 4 HEX)
if(NOT header STREQUAL "69636e73")
  message(FATAL_ERROR "Bundle icon is not an ICNS file")
endif()
